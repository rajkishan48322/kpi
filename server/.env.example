# Copy this file to .env and fill in real values. Never commit .env.
PORT=5010

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=kpi
DB_USER=postgres
DB_PASSWORD=

# Comma-separated list of origins allowed to call this API directly
# (not needed when the frontend is served through the same Apache proxy path).
CORS_ORIGINS=
